# Flare settings
MIN_CLIENTS=3
NUM_CLIENTS=3
NUM_ROUNDS=1
NUM_EPOCHS=1

# PyTorch settings
BATCH_SIZE=2

# Runtime data (full copy of project's data/, read by NVFlare clients at runtime)
RUNTIME_DATA_ROOT=/tmp/nvflare/data/lung_function
# The training dataset path. It should be a relative path under $RUNTIME_DATA_ROOT
MANIFEST_PATH=processed/convnext/image_manifest.csv

# Model settings

